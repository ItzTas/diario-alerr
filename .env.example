POSTGRES_PASSWORD=change-me

# Compose reads this file. The plugin and the tests don't, so export what you need in your shell.

# With this set, cargo test uses the compose Postgres instead of starting its own.
TEST_DATABASE_URL=postgres://diario_alerr:change-me@127.0.0.1:5432/diario_alerr?sslmode=disable

# The plugin's settings. Under monitor-hub, set them on the hub with the DIARIO__ prefix
# (DIARIO__WATCH_TERMS and so on). The hub removes the prefix before it starts the plugin.
DATABASE_URL=postgres://diario_alerr:change-me@127.0.0.1:5432/diario_alerr?sslmode=disable
WATCH_TERMS=FULANO DE TAL,0000000x
CHECK_INTERVAL_MINUTES=30
START_AFTER=2026-11-01
