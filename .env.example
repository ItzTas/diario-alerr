# Hostname the reverse proxy serves the RSS feed on
PUBLIC_HOST=diario.example.com

# Comma-separated; matching ignores accents, case and line breaks
WATCH_TERMS=FULANO DE TAL,0000000x

# From @BotFather; chat id from https://api.telegram.org/bot<TOKEN>/getUpdates after messaging the bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Editions uploaded after this date are scanned on the first run
START_AFTER=2026-11-01
CHECK_INTERVAL_MINUTES=30
